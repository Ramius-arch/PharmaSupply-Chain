{
  "name": "pharmasupply-blockchain",
  "version": "1.0.0",
  "description": "A pharmaceutical supply chain management system.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "manager",
    "web3"
  ],
  "scripts": {
    "backend": "npm start --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm:backend\" \"npm:frontend\"",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm test --workspace=backend"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@swc/core": "^1.15.43",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.2.0"
  }
}
